# Server-side only. Never sent to the browser. The app runs without it (OCR + text-layer only;
# handwriting, hand-drawn diagrams and scanned tables are then preserved and flagged, not read).
VISION_API_KEY=
# Pick ONE provider:
#   VISION_PROVIDER=anthropic   -> key from console.anthropic.com   (default model claude-sonnet-5-5)
#   VISION_PROVIDER=gemini      -> key from aistudio.google.com     (default model gemini-2.5-flash)
VISION_PROVIDER=anthropic
VISION_MODEL=
MAX_VISION_REGIONS=12
MAX_PAGES=60
